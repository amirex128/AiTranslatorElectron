# Model Selection
# Available models:
# Ollama: QWEN3_8B, GEMMA3_12B, LLAMA3_1_8B, GEMMA3_4B, QWEN3_14B
# OpenRouter: GEMMA3_27B_IT_OPENROUTER1, GEMMA3_27B_IT_OPENROUTER2, DEEPSEEK_V3_1_NEX_N1_OPENROUTER1, DEEPSEEK_V3_1_NEX_N1_OPENROUTER2, DEEPSEEK_R1T2_CHIMERA_OPENROUTER1, DEEPSEEK_R1T2_CHIMERA_OPENROUTER2, QWEN3_235B_A22B_OPENROUTER1, QWEN3_235B_A22B_OPENROUTER2, GLM_4_5_AIR_OPENROUTER1, GLM_4_5_AIR_OPENROUTER2
SELECTED_MODEL=QWEN3_8B
FALLBACK_SELECTED_MODEL=GEMMA3_27B_IT_OPENROUTER1

# AI Provider Configuration
# Ollama server URL (default: http://localhost:11434)
AI_PROVIDER_URL=http://localhost:11434

# OpenRouter Configuration
# OpenRouter API base URL
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter API keys (for load balancing between two keys)
OPEN_ROUTER_API_KEY_1=your-openrouter-api-key-1
OPEN_ROUTER_API_KEY_2=your-openrouter-api-key-2
# Referer and site name for OpenRouter requests
OPEN_ROUTER_REFERER=https://your-site.com
OPEN_ROUTER_SITE_NAME=Your Site Name

# AI Configuration
# Temperature setting (0.0 to 2.0, default: 0.7)
TEMPERATURE=0.7

# UI Configuration
# Base font size in pixels (default: 14)
FONT_SIZE=14
# Initial window dimensions in pixels
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800

# Keyboard Shortcuts
# Format: Alt+Key, Ctrl+Shift+Key, Cmd+Key
# Example: Alt+Insert, Ctrl+Shift+K, Alt+PageDown
SHORTCUT_PERSIAN_TO_ENGLISH=Alt+Insert
SHORTCUT_ENGLISH_TO_PERSIAN=Alt+Home
SHORTCUT_GRAMMAR=Alt+PageUp
SHORTCUT_RESPONSE_SUGGESTIONS=Alt+PageDown
SHORTCUT_PROCESS_MAIN=CommandOrControl+Enter
SHORTCUT_PROCESS_FALLBACK=Alt+Enter
SHORTCUT_PROCESS_QUICK_TRANSLATE=Shift+Enter
SHORTCUT_ADD_BOOKMARK=Alt+Delete

# Quick Translate Configuration
# Enable/disable quick translate feature (default: true)
QUICK_TRANSLATE_ENABLED=true
# Auto-close timeout in seconds (0 = no auto-close, default: 5)
QUICK_TRANSLATE_TIMEOUT=5
